# Settings used only by the F1 telemetry page.
REFRESH_SECONDS=0.5
FRAME_SECONDS=0.08
INFO_SWITCH_SECONDS=4
# Lower values produce a smoother, more gradual climb through the gears.
BAR_SMOOTHING=0.12
ANIMATE=true
# Flash the gear badge twice on upshifts and once on downshifts.
GEAR_SHIFT_FLASH=true
