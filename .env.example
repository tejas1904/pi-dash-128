# Copy this file to .env and change the values for your display.
OLED_DRIVER=sh1106
OLED_I2C_PORT=1
OLED_I2C_ADDRESS=0x3C
OLED_WIDTH=128
OLED_HEIGHT=64
# Rotation: 0, 1, 2, or 3 (clockwise quarter-turns)
OLED_ROTATE=0
# Lower brightness helps reduce OLED wear (0-255)
OLED_CONTRAST=128

# Select a folder from src/pi_dash_128/designs.
DASHBOARD_DESIGN=classic
